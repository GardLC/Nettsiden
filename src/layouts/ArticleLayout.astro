---
import BaseLayout from './BaseLayout.astro';

interface Props {
  tittel: string;
  tittelDisplay?: string;
  ingress?: string;
  publisert: Date;
  type: 'artikkel' | 'infographic';
  headerbilde?: string;
  tema?: string[];
}

const { tittel, tittelDisplay, ingress, publisert, type, headerbilde, tema } = Astro.props;

const dato = publisert.toLocaleDateString('nb-NO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout tittel={tittel} beskrivelse={ingress}>
  <main id="hovedinnhold">
    <div class="content-container">
      <article>
        {headerbilde && (
          <img
            src={headerbilde}
            alt={tittel}
            class="artikkel-headerbilde"
          />
        )}
        <header class="artikkel-header">
          <p class="artikkel-meta">
            <time datetime={publisert.toISOString()}>{dato}</time>
            {type === 'infographic' && <span class="artikkel-type">Infographic</span>}
          </p>
          {tittelDisplay
            ? <h1 set:html={tittelDisplay} />
            : <h1>{tittel}</h1>
          }
{ingress && <p class="artikkel-ingress">{ingress}</p>}
        </header>

        <div class="prose">
          <slot />
        </div>
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  main {
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  article {
    max-width: 68ch;
  }

  .artikkel-headerbilde {
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: center;
    margin-bottom: 2rem;
    border-radius: var(--radius);
  }

  .artikkel-header {
    margin-bottom: 3rem;
  }

  .artikkel-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .artikkel-type {
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius);
    font-size: var(--fs-small);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: var(--lh-heading);
    margin-bottom: 1.25rem;
  }

  .artikkel-ingress {
    font-size: var(--fs-body-large);
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
