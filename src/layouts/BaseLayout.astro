---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  tittel: string;
  beskrivelse: string;
  ogBilde?: string;
  kanonisk?: string;
}

const {
  tittel,
  beskrivelse,
  ogBilde = '/og-default.png',
  kanonisk = Astro.url.href,
} = Astro.props;

const nettstedNavn = 'Gard L. Christiansen';
const fullTittel = tittel === nettstedNavn ? tittel : `${tittel} – ${nettstedNavn}`;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTittel}</title>
<link rel="stylesheet" href="https://use.typekit.net/etg7can.css">
    <meta name="description" content={beskrivelse} />
    <link rel="canonical" href={kanonisk} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTittel} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:url" content={kanonisk} />
    <meta property="og:image" content={new URL(ogBilde, Astro.site)} />
    <meta property="og:site_name" content={nettstedNavn} />
    <meta property="og:locale" content="nb_NO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTittel} />
    <meta name="twitter:description" content={beskrivelse} />
    <meta name="twitter:image" content={new URL(ogBilde, Astro.site)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <style is:global>
    html, body {
      background-color: var(--color-bg);
    }
    body {
      padding: 2rem;
    }
    .pagina-boks {
      background-color: var(--color-bg);
      border-radius: 1.5rem;
      overflow: hidden;
    }
    main {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      background-color: var(--color-bg);
    }
    section, footer {
      background-color: var(--color-bg-box);
      border-radius: 1.5rem;
    }
  </style>
  <body>
    <a class="skip-link" href="#hovedinnhold">Hopp til innhold</a>
    <Header />
    <slot />
  </body>
</html>
