---
import FlokeAnimation from './FlokeAnimation.astro';
---

<section class="hero" aria-labelledby="hero-overskrift">
  <FlokeAnimation />
  <div class="container">
    <div class="hero-tekst">
      <h1 id="hero-overskrift" class="display">
        Nye arbeidshverdager<br>
        med <mark class="aksent">mer samspill</mark><br>
        og mindre friksjon
      </h1>
      <div class="hero-undertekst">
        <p class="body-large">Arbeidshverdagen er full av øyeblikk som fremmer eller hemmer engasjement samarbeid og trivsel</p>
        <p class="body-large">De færreste er bevisst utformet<br> De har ofte bare ramlet på plass </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block-start: calc(var(--headline-anchor) + 4rem - 5rem);
    padding-block-end: var(--section-spacing);
    background-color: var(--color-sand);
    justify-content: flex-start;
  }


  .hero .container {
    position: relative;
    z-index: 1;
  }

  .hero-tekst {
    position: relative;
  }

  .display {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: 3.375rem;
    letter-spacing: -0.015em;
    line-height: 1.15;
    color: var(--color-text);
    margin-top: calc(2 * 3.375rem * 1.15);
    margin-bottom: calc(1.625rem * 1.6);
    position: relative;
    z-index: 1;
  }

  mark.aksent {
    background: transparent;
    color: inherit;
    padding: 0;
    border-radius: 0;
    white-space: nowrap;
  }

  .hero-undertekst {
    color: var(--color-text);
    max-width: 560px;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

</style>
