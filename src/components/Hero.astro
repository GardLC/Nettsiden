---
import FlokeAnimation from './FlokeAnimation.astro';
---

<section class="hero" aria-labelledby="hero-overskrift">
  <div class="container">
    <div class="hero-tekst">
      <FlokeAnimation />
      <h1 id="hero-overskrift" class="display">
        Nye arbeidshverdager<br>
        med <mark class="aksent">mer samspill</mark><br>
        og mindre friksjon
      </h1>
      <p class="body-large hero-undertekst">
        Bedre arbeidshverdager skapes sammen med de ansatte og deres ledere, ikke for dem.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block-start: 28vh;
    padding-block-end: var(--section-spacing);
    background-color: var(--color-off-white);
    justify-content: flex-start;
  }

  .hero .container {
    position: relative;
    z-index: 1;
  }

  .hero-tekst {
    position: relative;
  }

  .display {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: var(--lh-display);
    color: var(--color-text);
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  mark.aksent {
    background: var(--color-accent);
    color: inherit;
    padding: 0 0.12em;
    border-radius: 2px;
    white-space: nowrap;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero-undertekst {
    color: var(--color-text);
    max-width: 560px;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 480px) {
    .display {
      font-size: 2rem;
    }
  }

  @media (max-width: 380px) {
    .display {
      font-size: 1.75rem;
    }
  }
</style>
