---
import FlokeAnimation from './FlokeAnimation.astro';
---

<section class="hero" aria-labelledby="hero-overskrift">
  <div class="container">
    <div class="hero-tekst">
      <FlokeAnimation />
      <h1 id="hero-overskrift" class="display">
        Norske arbeidsgivere bruker store ressurser på å rekruttere de rette menneskene. Innfasingen overlates til tilfeldighetene.
      </h1>
      <blockquote class="hero-sitat">
        <p class="hero-sitat-tekst">«Vår innfasing er pinlig dårlig, vi har snakket om det lenge.»</p>
        <footer class="hero-sitat-kilde">— Tech lead</footer>
      </blockquote>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block-start: 28vh;
    padding-block-end: var(--section-spacing);
    background-color: var(--color-off-white);
    justify-content: flex-start;
  }

  .hero .container {
    position: relative;
    z-index: 1;
  }

  .hero-tekst {
    position: relative;
  }

  .display {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: var(--lh-display);
    color: var(--color-text);
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .hero-sitat {
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .hero-sitat-tekst {
    font-family: var(--font-body);
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    font-weight: var(--fw-regular);
    font-style: italic;
    margin-bottom: 0.4rem;
  }

  .hero-sitat-kilde {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-regular);
    color: var(--color-text);
  }

  @media (max-width: 480px) {
    .display {
      font-size: 2rem;
    }
  }

  @media (max-width: 380px) {
    .display {
      font-size: 1.75rem;
    }
  }
</style>
