---
---

<section class="hero" aria-labelledby="hero-overskrift">
  <div class="container">
    <div class="hero-tekst">
      <h1 id="hero-overskrift" class="display">
        Nye arbeidshverdager<br>
        med <mark class="aksent">mer samspill</mark> og<br>
        mindre friksjon
      </h1>
      <p class="body-large hero-undertekst">
        Bedre arbeidshverdager skapes sammen med de ansatte og deres ledere, ikke for dem.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--section-spacing);
  }

  .hero-tekst {
    /* ingen max-width — h1 får full container-bredde, undertekst styrer sin egne */
  }

  .display {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    margin-bottom: 1.5rem;
  }

  mark.aksent {
    background: var(--color-accent);
    color: inherit;
    padding: 0 0.12em;
    border-radius: 2px;
    white-space: nowrap;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero-undertekst {
    color: var(--color-text);
    max-width: 560px;
  }

  @media (max-width: 480px) {
    .display {
      font-size: 2rem;
    }
  }

  @media (max-width: 380px) {
    .display {
      font-size: 1.75rem;
    }
  }
</style>
