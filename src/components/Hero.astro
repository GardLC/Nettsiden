---
import FlokeAnimation from './FlokeAnimation.astro';
---

<section class="hero" aria-labelledby="hero-overskrift">
  <FlokeAnimation />
  <div class="container">
    <div class="hero-tekst">
      <h1 id="hero-overskrift" class="display">
        Nye arbeidshverdager<br>
        med <mark class="aksent">mer samspill</mark><br>
        og mindre friksjon
      </h1>
      <div class="hero-undertekst">
        <p class="body-large">Arbeidshverdagen er full av øyeblikk som fremmer<br> eller hemmer engasjement, samarbeid og trivsel.</p>
        <p class="body-large">De færreste er bevisst utformet.<br> De har ofte bare ramla på plass. </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block-start: calc(var(--headline-anchor) + 4rem - 5rem);
    padding-block-end: var(--section-spacing);
    background-color: var(--color-sand);
    justify-content: flex-start;
  }

  .hero .container {
    position: relative;
    z-index: 1;
  }

  .hero-tekst {
    position: relative;
  }

  .display {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: var(--lh-display);
    color: var(--color-text);
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  mark.aksent {
  background: transparent;
  color: inherit;
  padding: 0;
  border-radius: 0;
  white-space: nowrap;
}
  }

  .hero-undertekst {
    color: var(--color-text);
    max-width: 560px;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (max-width: 480px) {
    .display {
      font-size: 2rem;
    }
  }

  @media (max-width: 380px) {
    .display {
      font-size: 1.75rem;
    }
  }
</style>
