---
const RADER = 5;
const KOLONNER = 20;
const RADIUS = 6;
const AVSTAND = 16;
const LIME_FRA = 4;
const LIME_TIL = 16;
const BUNN_RAD = RADER - 1;
const BREDDE = 2 * RADIUS + (KOLONNER - 1) * AVSTAND;
const HOYDE = 2 * RADIUS + (RADER - 1) * AVSTAND;

type Prikk = { cx: number; cy: number; erLime: boolean };
const prikker: Prikk[] = [];
for (let r = 0; r < RADER; r++) {
  for (let k = 0; k < KOLONNER; k++) {
    const erBunn = r === BUNN_RAD;
    prikker.push({
      cx: RADIUS + k * AVSTAND,
      cy: RADIUS + r * AVSTAND,
      erLime: erBunn && k >= LIME_FRA && k < LIME_TIL,
    });
  }
}
---

<section class="nyansattsitater" aria-labelledby="nyansattsitater-overskrift">
  <div class="container">
    <h2 id="nyansattsitater-overskrift" class="nyansattsitater-tittel">
      Hva de nyansatte sier
    </h2>
  </div>

  <div class="to-kolonner">
    <div class="venstre-kolonne">
      <ul class="sitat-liste" role="list">
        <li class="sitat-blokk">
          <blockquote class="sitat">Det viktigste for meg er egentlig å føle at folk forventer at jeg skal begynne. <br>At utstyr er klart, at noen tar deg imot, at jeg slipper å sitte alene og være usikker.</blockquote>
          <p class="sitat-kilde">Nyansatt</p>
        </li>
        <li class="sitat-blokk">
          <blockquote class="sitat">Det handler om at jeg vil lykkes og trives godt i jobben. Som ung er det mye som må læres, og da er det betryggende å bli møtt med en god plan.</blockquote>
          <p class="sitat-kilde">Nyutdannet</p>
        </li>
      </ul>
    </div>

    <div class="stat-blokk">
      <p class="stat-tall">12 %</p>
      <svg
        class="prikke-grid"
        viewBox={`0 0 ${BREDDE} ${HOYDE}`}
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        {prikker.map((p) => (
          <circle
            cx={p.cx}
            cy={p.cy}
            r={RADIUS}
            style={`fill: ${p.erLime ? 'var(--color-terrakotta)' : 'var(--color-salviegronn)'}`}
          />
        ))}
      </svg>
      <p class="stat-tekst">sier de har fått en god innfasing</p>
    </div>
  </div>
  <footer class="kilde-blokk">
    <p class="kilde-tekst">HR Norge<br />Egne intervjuer 2023</p>
  </footer>
</section>

<style>
  .nyansattsitater {
    padding-block-end: 6rem;
    position: relative;
    min-height: calc(100vh - 3cm);
  }

  .nyansattsitater-tittel {
    font-family: var(--font-body);
    font-size: 3.375rem;
    font-weight: var(--fw-regular);
    line-height: var(--lh-heading);
    color: #000000;
    margin: 0 0 3rem 0;
  }

  .to-kolonner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: start;
    margin-block: auto;
    transform: translateY(-4.8rem);
    padding-inline-start: clamp(7.5rem, 15vw, 13.5rem);
    padding-inline-end: calc(var(--gutter) + max(0px, (100vw - var(--max-width)) / 2));
  }

  .venstre-kolonne {
    display: flex;
    flex-direction: column;
  }

  .sitat-liste {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .sitat-blokk {
    max-width: 560px;
  }

  .sitat {
    font-family: var(--font-serif);
    font-weight: var(--fw-regular);
    font-size: 26.67px;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .sitat-kilde {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 1.125rem;
    color: var(--color-text);
  }

  .stat-blokk {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
    justify-self: end;
  }

  .stat-tall {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: var(--fs-display);
    line-height: 1;
    color: var(--color-terrakotta);
    margin: 0 0 2rem;
  }

  .prikke-grid {
    width: 100%;
    height: auto;
    margin-inline: auto;
  }

  .stat-tekst {
    font-family: var(--font-body);
    font-weight: var(--fw-book);
    font-size: 36px;
    line-height: var(--lh-heading);
    color: var(--color-terrakotta);
    white-space: nowrap;
  }

  .kilde-blokk {
    position: absolute;
    bottom: 2rem;
    right: var(--gutter);
  }

  .kilde-tekst {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 1.125rem;
    color: var(--color-text);
    text-align: right;
  }

  @media (max-width: 700px) {
    .to-kolonner {
      grid-template-columns: 1fr;
      padding-inline: var(--gutter);
      transform: none;
    }

    .stat-tekst {
      white-space: normal;
      font-size: clamp(1.5rem, 6vw, 42px);
    }

    .stat-tall {
      font-size: clamp(3rem, 18vw, var(--fs-display));
    }

    .sitat {
      font-size: 26.67px;
    }

    .nyansattsitater-tittel {
      font-size: clamp(1.75rem, 7vw, 3.375rem);
    }
  }
</style>
