<section class="nyansattsitater" aria-labelledby="nyansattsitater-overskrift">
  <div class="container">
    <h2 id="nyansattsitater-overskrift" class="nyansattsitater-tittel">
      Hva de nyansatte sier
    </h2>
    <li class="sitat-blokk">
      <blockquote class="sitat">«Det handler om at jeg vil lykkes og trives godt i jobben. Som ung er det mye som må læres, og da er det betryggende å bli møtt med en god plan.»</blockquote>
      <p class="sitat-kilde">Nyutdannet</p>
    </li>
    <p class="stat-fremhevet">12% sier de har fått en god innfasing</p>
    <li class="sitat-blokk">
      <blockquote class="sitat">«Det viktigste for meg er egentlig å føle at folk forventer at jeg skal begynne. At utstyr er klart, at noen tar deg imot, og at du slipper å sitte alene og være usikker.»</blockquote>
      <p class="sitat-kilde">Nyansatt</p>
    </li>
  </div>
</section>

<style>
  .nyansattsitater {
    background-color: var(--color-mosegronn);
  }

  .nyansattsitater-tittel {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: 3.75rem;
    line-height: var(--lh-heading);
    margin-bottom: 3rem;
  }

  .sitat-blokk {
    list-style: none;
    max-width: 760px;
    margin-bottom: 2.5rem;
  }

  .sitat {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .sitat-kilde {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 1.125rem;
    color: var(--color-text-muted);
    text-align: left;
  }

  .stat-fremhevet {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: var(--lh-heading);
    margin-block: 3rem;
    text-align: center;
  }
</style>
