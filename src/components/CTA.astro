---
---

<section id="kontakt" class="cta" aria-labelledby="cta-overskrift">
  <div class="container">
    <div class="cta-intro">
      <h1 id="cta-overskrift">
        <!-- PLASSHOLDER: overskrift som inviterer til samtale -->
      </h1>
      <p class="body-large cta-tekst">
        <!-- PLASSHOLDER: kort tekst om hva man kan kontakte for -->
      </p>
      <!-- LinkedIn-lenke — bytt ut href med din LinkedIn-URL og legg inn ikon -->
      <a href="https://www.linkedin.com/in/gardc/" class="cta-linkedin" target="_blank" rel="noopener noreferrer" aria-label="Besøk LinkedIn-profilen min">
        <img src="/linkedin.svg" alt="" aria-hidden="true" class="cta-linkedin-ikon" />
        LinkedIn
      </a>
    </div>

    <hr class="cta-skillelinje" aria-hidden="true" />
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-spacing);
    color: var(--color-off-white);
  }

  .cta .container {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .cta-skillelinje {
    border: none;
    border-top: 1.5px solid var(--color-off-white);
    margin: 0;
  }

  .cta-intro h1 {
    margin-bottom: 1rem;
  }

  .cta-tekst {
    color: rgba(229, 225, 222, 0.75);
    margin-bottom: 1.5rem;
  }

  .cta-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--fs-body-large);
    color: var(--color-off-white);
    text-decoration: none;
  }

  .cta-linkedin:hover {
    color: rgba(229, 225, 222, 0.7);
  }

  .cta-linkedin-ikon {
    width: 1.25rem;
    height: 1.25rem;
    filter: brightness(0) invert(1);
  }

  @media (max-width: 768px) {
    .cta-intro {
      max-width: 100%;
    }
  }
</style>
