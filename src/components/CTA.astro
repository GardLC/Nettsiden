---
---

<section id="kontakt" class="cta" aria-labelledby="cta-overskrift">
  <div class="container">
    <div class="cta-intro">
      <h1 id="cta-overskrift">
        <!-- PLASSHOLDER: overskrift som inviterer til samtale -->
      </h1>
      <p class="body-large cta-tekst">
        <!-- PLASSHOLDER: kort tekst om hva man kan kontakte for -->
      </p>
      <!-- LinkedIn-lenke — bytt ut href med din LinkedIn-URL og legg inn ikon -->
      <a href="https://www.linkedin.com/in/gardc/" class="cta-linkedin" target="_blank" rel="noopener noreferrer" aria-label="Besøk LinkedIn-profilen min">
        <img src="/linkedin.svg" alt="" aria-hidden="true" class="cta-linkedin-ikon" />
        LinkedIn
      </a>
    </div>

    <div class="cta-skjema-wrapper">
      <!-- Formspree: gå til formspree.io, opprett skjema med gardlchristiansen@gmail.com, erstatt XXXXXXX med din form-ID -->
      <form
        class="kontaktskjema"
        action="https://formspree.io/f/xykvdzba"
        method="POST"
        aria-label="Kontaktskjema"
        novalidate
      >
        <div class="skjema-gruppe">
          <label for="navn" class="skjema-label">Navn</label>
          <input
            type="text"
            id="navn"
            name="navn"
            class="skjema-felt"
            autocomplete="name"
            required
            aria-required="true"
          />
        </div>

        <div class="skjema-gruppe">
          <label for="epost" class="skjema-label">E-post</label>
          <input
            type="email"
            id="epost"
            name="epost"
            class="skjema-felt"
            autocomplete="email"
            required
            aria-required="true"
          />
        </div>

        <div class="skjema-gruppe">
          <label for="melding" class="skjema-label">Melding</label>
          <textarea
            id="melding"
            name="melding"
            class="skjema-felt skjema-textarea"
            rows="5"
            required
            aria-required="true"
          ></textarea>
        </div>

        <button type="submit" class="btn skjema-send">Send melding</button>
      </form>
    </div>
  </div>
</section>

<style>
  .cta {
    background-color: var(--color-oliven-dyp);
    color: var(--color-off-white);
  }

  .cta .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .cta-intro h1 {
    margin-bottom: 1rem;
  }

  .cta-tekst {
    color: rgba(229, 225, 222, 0.75);
    margin-bottom: 1.5rem;
  }

  .cta-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--fs-body-large);
    color: var(--color-off-white);
    text-decoration: none;
  }

  .cta-linkedin:hover {
    color: rgba(229, 225, 222, 0.7);
  }

  .cta-linkedin-ikon {
    width: 1.25rem;
    height: 1.25rem;
    filter: brightness(0) invert(1);
  }

  .kontaktskjema {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .skjema-gruppe {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .skjema-label {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--fs-small);
    color: var(--color-off-white);
  }

  .skjema-felt {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: var(--fs-body);
    color: var(--color-off-white);
    background-color: rgba(255, 255, 255, 0.08);
    border: 1.5px solid rgba(229, 225, 222, 0.25);
    border-radius: var(--radius);
    padding: 0.625rem 0.875rem;
    width: 100%;
    transition: border-color 0.15s ease;
  }

  .skjema-felt:focus {
    outline: none;
    border-color: var(--color-off-white);
  }

  .skjema-felt:focus-visible {
    outline: 2px solid var(--color-off-white);
    outline-offset: 2px;
  }

  .skjema-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .skjema-send {
    align-self: flex-start;
  }

  .btn {
    border-color: var(--color-off-white);
    color: var(--color-off-white);
  }

  .btn:hover {
    background: var(--color-off-white);
    color: var(--color-oliven-dyp);
  }

  @media (max-width: 768px) {
    .cta .container {
      grid-template-columns: 1fr;
    }
  }
</style>
