---
---

<section id="kontakt" class="cta" aria-labelledby="cta-overskrift">
  <div class="container">
    <div class="cta-intro">
      <h1 id="cta-overskrift">
        <!-- PLASSHOLDER: overskrift som inviterer til samtale -->
      </h1>
      <p class="body-large cta-tekst">
        <!-- PLASSHOLDER: kort tekst om hva man kan kontakte for -->
      </p>
      <a href="mailto:kontakt@gardlc.com" class="cta-epost">kontakt@gardlc.com</a>
    </div>

    <div class="cta-skjema-wrapper">
      <!-- PLASSHOLDER: Erstatt action-URL med din Formspree-endpoint, f.eks. https://formspree.io/f/XXXXXXX -->
      <form
        class="kontaktskjema"
        action="https://formspree.io/f/XXXXXXX"
        method="POST"
        aria-label="Kontaktskjema"
        novalidate
      >
        <div class="skjema-gruppe">
          <label for="navn" class="skjema-label">Navn</label>
          <input
            type="text"
            id="navn"
            name="navn"
            class="skjema-felt"
            autocomplete="name"
            required
            aria-required="true"
          />
        </div>

        <div class="skjema-gruppe">
          <label for="epost" class="skjema-label">E-post</label>
          <input
            type="email"
            id="epost"
            name="epost"
            class="skjema-felt"
            autocomplete="email"
            required
            aria-required="true"
          />
        </div>

        <div class="skjema-gruppe">
          <label for="melding" class="skjema-label">Melding</label>
          <textarea
            id="melding"
            name="melding"
            class="skjema-felt skjema-textarea"
            rows="5"
            required
            aria-required="true"
          ></textarea>
        </div>

        <button type="submit" class="btn skjema-send">Send melding</button>
      </form>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-spacing);
    border-top: 1px solid var(--color-border);
  }

  .cta .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .cta-intro h1 {
    margin-bottom: 1rem;
  }

  .cta-tekst {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .cta-epost {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--fs-body-large);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cta-epost:hover {
    color: var(--color-text-muted);
  }

  .kontaktskjema {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .skjema-gruppe {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .skjema-label {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--fs-small);
    color: var(--color-text);
  }

  .skjema-felt {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: var(--fs-body);
    color: var(--color-text);
    background-color: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.625rem 0.875rem;
    width: 100%;
    transition: border-color 0.15s ease;
  }

  .skjema-felt:focus {
    outline: none;
    border-color: var(--color-text);
  }

  .skjema-felt:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .skjema-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .skjema-send {
    align-self: flex-start;
  }

  @media (max-width: 768px) {
    .cta .container {
      grid-template-columns: 1fr;
    }
  }
</style>
