---
import Accordion from './Accordion.astro';

const omrader = [
  {
    tittel: 'Innfasing av medarbeidere (onboarding)',
    forklaring: 'I Norge er de fleste onboardingprogrammer laget for virksomhetens behov, ikke den nyansattes. Strukturerte prosesser som tar utgangspunkt i de nyes opplevelse kan halvere tiden det tar å bli produktiv. Sammen finner vi ut hvor det lugger og gjør innfasing til en konkurransefordel.',
  },
  {
    tittel: 'Medarbeider- og kandidatopplevelser',
    forklaring: 'De fleste virksomheter designer ikke medarbeider- og kandidatopplevelsen bevisst - de lar den bare oppstå. Opplevelsen av å søke, bli ansatt og jobbe hos dere former omdømme og engasjement, men uten innsikt blir kvaliteten en blindsone. Sammen kartlegger vi reisen, identifiserer friksjonspunktene og utvikler forbedringer som styrker både omdømme og produktivitet.',
  },
  {
    tittel: 'Læring og utvikling',
    forklaring: 'Kompetansetiltak som ikke henger sammen med hverdagens faktiske arbeidsoppgaver forsvinner - uansett innhold og budsjett. Problemet er sjelden hva som læres, men at tiltakene er utviklet isolert fra de som skal bruke dem. Sammen med ansatte og ledere finner vi ut hva som faktisk trengs og bygger tiltak som integreres i arbeidshverdagen.',
  },
  {
    tittel: 'Mangfold, likestilling og inkludering',
    forklaring: 'Gode intensjoner om inkludering er ikke nok hvis prosessene ikke støtter dem. Forskning viser at varig endring kommer av systemer designet for rettferdige beslutninger - ikke av kurs og bevisstgjøring alene. Sammen finner vi ut hvor skjevhetene faktisk oppstår og designer strukturer og prosesser som gjør det lettere å ta rettferdige valg.',
  },
  {
    tittel: 'Innsikt og gap-analyse',
    forklaring: 'De fleste HR-tiltak er basert på antakelser om hva ansatte og ledere faktisk opplever - ikke systematisk innsikt. Gjennom taktisk empati med de involverte får vi et realistisk bilde av nåsituasjonen. Resultatet er en gap-analyse som gir et konkret beslutningsgrunnlag for hva som faktisk bør prioriteres.',
  },
];
---

<section class="hvor-bidrar" aria-labelledby="hvor-bidrar-overskrift">
  <div class="container">
    <h1 id="hvor-bidrar-overskrift">Hvor jeg ønsker å bidra</h1>
    <Accordion items={omrader} />
  </div>
</section>

<style>
  .hvor-bidrar {
    padding-block: var(--section-spacing);
    background-color: var(--color-sand);
  }

  .hvor-bidrar h1 {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
</style>
