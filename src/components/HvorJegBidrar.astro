---
import Accordion from './Accordion.astro';

const omrader = [
  { tittel: 'Innfasing av medarbeidere (onboarding)' },
  { tittel: 'Medarbeider- og kandidatopplevelser' },
  { tittel: 'Læring og utvikling' },
  { tittel: 'Mangfold, likestilling og inkludering' },
  { tittel: 'Innsikt og gap-analyse' },
];
---

<section class="hvor-bidrar" aria-labelledby="hvor-bidrar-overskrift">
  <div class="container">
    <h1 id="hvor-bidrar-overskrift">Hvor jeg kan bidra</h1>
    <Accordion items={omrader} />
  </div>
</section>

<style>
  .hvor-bidrar {
    padding-block: var(--section-spacing);
    background-color: var(--color-sand);
  }

  .hvor-bidrar h1 {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
</style>
