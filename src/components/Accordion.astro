---
interface AccordionItem {
  tittel: string;
  forklaring?: string;
  etikett?: string;
  defaultOpen?: boolean;
}

interface Props {
  items: AccordionItem[];
}

const { items } = Astro.props;
---

<div class="accordion">
  {items.map((item) => (
    <details open={item.defaultOpen ?? false}>
      <summary>
        <span class="summary-inner">
          {item.etikett && <span class="etikett">{item.etikett}</span>}
          <span class="tittel">{item.tittel}</span>
        </span>
        <span class="toggle" aria-hidden="true"></span>
      </summary>
      <div class="panel">
        <p>{item.forklaring ?? '— Plassholder: beskrivende tekst —'}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .accordion {
    border-top: 1px solid var(--color-border);
  }

  details {
    border-bottom: 1px solid var(--color-border);
  }

  summary {
    list-style: none;
    cursor: pointer;
    padding: 1rem 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    font-size: 28px;
    line-height: var(--lh-heading);
    color: var(--color-text);
    position: relative;
    transition: padding-left 0.18s ease;
  }

  summary::-webkit-details-marker { display: none; }

  summary::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 0;
    height: 3px;
    background: var(--color-accent);
    transform: translateY(-50%);
    transition: width 0.18s ease;
  }

  details[open] > summary,
  summary:hover {
    padding-left: 2rem;
  }

  details[open] > summary::before,
  summary:hover::before {
    width: 1.5rem;
  }

  .summary-inner {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .etikett {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    flex-shrink: 0;
    width: 2rem;
  }

  .toggle {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    position: relative;
  }

  .toggle::before,
  .toggle::after {
    content: "";
    position: absolute;
    background: var(--color-text);
    top: 50%;
    left: 50%;
    transition: transform 0.2s ease;
  }

  .toggle::before {
    width: 14px;
    height: 2px;
    transform: translate(-50%, -50%);
  }

  .toggle::after {
    width: 2px;
    height: 14px;
    transform: translate(-50%, -50%);
  }

  details[open] .toggle::after {
    transform: translate(-50%, -50%) scaleY(0);
  }

  .panel {
    padding: 0 0 1rem 2rem;
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: var(--lh-body);
    max-width: 60ch;
  }
</style>
