---
---

<section class="problembevis" aria-labelledby="problembevis-overskrift">
  <div class="container">
    <div class="problembevis-inner">
      <h2 id="problembevis-overskrift" class="seksjon-overskrift">Hva de nyansatte sier</h2>
      <blockquote class="sitat">
        <p class="sitat-tekst">«Det handler om mine sjanser for å lykkes godt i jobben. Som ung er det viktig å få en god start, og da er innfasingen veldig viktig.»</p>
        <footer class="sitat-kilde">— Nyansatt</footer>
      </blockquote>
      <p class="ingress">De heldige som får en skikkelig god start er alt for få.</p>
      <div class="tall-blokk">
        <span class="stort-tall" aria-label="12 prosent">12%</span>
      </div>
      <div class="kilde-blokk" aria-label="Kilde">
        <p class="kilde-tekst">Kilde: GELx 2017 via HR Norge</p>
      </div>
    </div>
  </div>
</section>

<style>
  .problembevis {
  }

  .problembevis-inner {
    max-width: var(--content-width);
  }

.seksjon-overskrift {
  font-family: var(--font-body);
  font-size: 3.75rem;
  line-height: var(--lh-heading);
  font-weight: var(--fw-regular);
  margin-bottom: clamp(2rem, 4vw, 3rem);
}

  .sitat {
    margin: 0 0 2.5rem 0;
  }

  .sitat-tekst {
    font-family: var(--font-body);
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    font-weight: var(--fw-regular);
    font-style: italic;
    margin-bottom: 0.4rem;
  }

  .sitat-kilde {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-regular);
    color: var(--color-text);
  }

  .ingress {
    font-family: var(--font-body);
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    font-weight: var(--fw-regular);
    margin-bottom: 0.75rem;
  }

  .tall-blokk {
    margin-bottom: 2.5rem;
  }

  .stort-tall {
    font-family: var(--font-body);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    display: block;
  }

  .kilde-blokk {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .kilde-tekst {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: var(--fw-book);
    color: var(--color-text-muted);
  }
</style>
