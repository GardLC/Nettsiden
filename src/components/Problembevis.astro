---
---

<section class="problembevis" aria-labelledby="problembevis-overskrift">
  <div class="container">
    <div class="problembevis-inner">
      <div class="tall-blokk">
        <span class="stort-tall" aria-label="12 prosent">12%</span>
      </div>
      <p class="body-large forklaring">
        ...sier de har fått en veldig bra innfasing.
      </p>
      <p class="body-large konklusjon">
        Stemmene over er ikke unntak.
      </p>
      <div class="kilder small" aria-label="Kilder">
        <p>Kilde: GELx 2017 via HR Norge Onboardingundersøkelsen 2023</p>
      </div>
    </div>
  </div>
</section>

<style>
  .problembevis {
    padding-block: var(--section-spacing);
    background-color: var(--color-mosegronn);
  }

  .problembevis-inner {
    max-width: var(--content-width);
  }

  .tall-blokk {
    margin-bottom: 1.5rem;
  }

  .stort-tall {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    color: var(--color-text);
    display: block;
  }

  .forklaring {
    line-height: var(--lh-body);
    margin-bottom: 1rem;
  }

  .konklusjon {
    line-height: var(--lh-body);
    margin-bottom: 2rem;
  }

  .kilder {
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
</style>
