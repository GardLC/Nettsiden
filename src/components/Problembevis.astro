---
---

<section class="problembevis" aria-labelledby="problembevis-overskrift">
  <div class="container">
    <div class="problembevis-inner">
      <div class="tall-blokk">
        <span class="stort-tall" aria-label="12 prosent">12%</span>
      </div>
      <p class="plassholder body-large">
        [PLASSHOLDER: Setning som forklarer hva 12%-tallet betyr]
      </p>
      <p class="plassholder body-large">
        [PLASSHOLDER: Setning om at norske ledere bekrefter det samme og peker på tid, kompetanse og verktøy]
      </p>
      <div class="kilder small" aria-label="Kilder">
        <p>Kilder: HR Norge, Onboardingundersøkelsen 2023 · 15 dybdeintervjuer med norske ledere</p>
      </div>
    </div>
  </div>
</section>

<style>
  .problembevis {
    padding-block: var(--section-spacing);
    border-top: 1px solid var(--color-border);
  }

  .problembevis-inner {
    max-width: var(--content-width);
  }

  .tall-blokk {
    margin-bottom: 2rem;
  }

  .stort-tall {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    color: var(--color-text);
    display: block;
  }

  .plassholder {
    font-family: var(--font-body);
    font-size: var(--fs-body-large);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
    background-color: #e0e0e0;
    border: 1px dashed #999;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    margin-bottom: 1rem;
  }

  .kilder {
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
</style>
