---
---

<section class="problembevis" aria-labelledby="problembevis-overskrift">
  <div class="container">
    <div class="problembevis-inner">
      <h2 id="problembevis-overskrift" class="seksjon-overskrift">Hva de nyansatte sier</h2>
      <div class="tall-blokk">
        <span class="stort-tall" aria-label="12 prosent">12%</span>
        <p class="tall-forklaring">...sier de har fått en veldig bra innfasing.</p>
      </div>
      <p class="konklusjon">
        Stemmene over er ikke unntak.
      </p>
      <div class="kilder" aria-label="Kilder">
        <p class="kilde-tekst">Kilde: GELx 2017 via HR Norge Onboardingundersøkelsen 2023</p>
      </div>
    </div>
  </div>
</section>

<style>
  .problembevis {
    padding-block: var(--section-spacing);
    background-color: var(--color-mosegronn);
  }

  .problembevis-inner {
    max-width: var(--content-width);
  }

  .seksjon-overskrift {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-heading);
    font-weight: var(--fw-medium);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .tall-blokk {
    margin-bottom: 2rem;
  }

  .stort-tall {
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    color: var(--color-text);
    display: block;
  }

  .tall-forklaring {
    font-family: var(--font-body);
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    font-weight: var(--fw-regular);
  }

  .konklusjon {
    font-family: var(--font-body);
    font-size: var(--fs-body-large);
    line-height: var(--lh-body);
    font-weight: var(--fw-regular);
    margin-bottom: 2.5rem;
  }

  .kilder {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .kilde-tekst {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: var(--fw-book);
    color: var(--color-text-muted);
  }
</style>
