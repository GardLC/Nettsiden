<div class="shapes-stage" id="shapes-stage" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
    <path id="sp0" d="M0 297.77L114.48 51.5 381.13 0 266.65 246.27 0 297.77z"/>
    <path id="sp1" d="M305 391.55L143.52 451 0 59.45 161.48 0 305 391.55z"/>
    <path id="sp2" d="M175.57 223.91C62.35 187.82-15.13 112.71 2.5 56.15S126.22-17 239.43 19.09s190.7 111.2 173.07 167.76S288.78 260 175.57 223.91z"/>
    <path id="sp3" d="M399 295.14L326.01 376 0 80.86 72.99 0 399 295.14z"/>
    <path id="sp4" d="M884.5 52.47L24.05 447.6 0 395.13 860.46 0l24.04 52.47z"/>
    <path id="sp5" d="M222.91 162.71l-94.16 74.98L17.3 193.83 0 74.98 94.16 0l111.45 43.86 17.3 118.85z"/>
    <path id="sp6" d="M315 158c0 87.26-70.52 158-157.5 158S0 245.26 0 158 70.52 0 157.5 0 315 70.74 315 158"/>
  </svg>
</div>

<style>
  .shapes-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  :global(.shapes-stage .shape) {
    position: absolute;
    transform-origin: 50% 50%;
    mix-blend-mode: multiply;
    opacity: 0.75;
    pointer-events: none;
  }

  :global(.shapes-stage .shape svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.shapes-stage .shape--light) {
    mix-blend-mode: normal;
  }
</style>

<script is:inline>
(function () {
  var CAT_SHAPE   = 0x0001;
  var CAT_WALL    = 0x0002;
  var CAT_CHEVRON = 0x0004;
  var CAT_OVAL    = 0x0008;

  var SHAPES = [
    { id:'sp3', color:'#E8C08D',
      path:'M399 295.14L326.01 376 0 80.86 72.99 0 399 295.14z',
      vw:399, vh:376, x:-0.04, y:200, a:-0.20,
      density:0.002, restitution:0.06, friction:0.80, frictionAir:0.022 },
    { id:'sp6', color:'#E8C08D',
      path:'M315 158c0 87.26-70.52 158-157.5 158S0 245.26 0 158 70.52 0 157.5 0 315 70.74 315 158',
      vw:315, vh:316, x:0.16, y:320, a:0.00,
      density:0.001, restitution:0.72, friction:0.10, frictionAir:0.005 },
    { id:'sp4', color:'#ABB087',
      path:'M884.5 52.47L24.05 447.6 0 395.13 860.46 0l24.04 52.47z',
      vw:885, vh:448, x:0.40, y:160, a:-0.20,
      density:0.003, restitution:0.04, friction:0.90, frictionAir:0.014 },
    { id:'sp1', color:'#ABB087',
      path:'M305 391.55L143.52 451 0 59.45 161.48 0 305 391.55z',
      vw:305, vh:451, x:0.50, y:360, a:0.03,
      density:0.002, restitution:0.08, friction:0.75, frictionAir:0.018 },
    { id:'sp5', color:'#DCFFA7',
      path:'M222.91 162.71l-94.16 74.98L17.3 193.83 0 74.98 94.16 0l111.45 43.86 17.3 118.85z',
      vw:223, vh:238, x:0.78, y:580, a:0.12,
      density:0.002, restitution:0.10, friction:0.50, frictionAir:0.022 },
    { id:'sp0', color:'#D68973',
      path:'M0 297.77L114.48 51.5 381.13 0 266.65 246.27 0 297.77z',
      vw:381, vh:298, x:0.78, y:240, a:-0.10,
      density:0.015, restitution:0.06, friction:0.70, frictionAir:0.035 },
  ];

  var OVAL = {
    id:'sp2', color:'#ABB087',
    path:'M175.57 223.91C62.35 187.82-15.13 112.71 2.5 56.15S126.22-17 239.43 19.09s190.7 111.2 173.07 167.76S288.78 260 175.57 223.91z',
    vw:415, vh:243, x:0.80, y:500, a:1.57,
    density:0.004, restitution:0.08, friction:0.30, frictionAir:0.018
  };

  var engine, runner, rafId;
  var bodies   = [];
  var elements = [];

  function loadScript(src, cb) {
    var s = document.createElement('script');
    s.src = src;
    s.onload = cb;
    document.head.appendChild(s);
  }

  function makeBody(s, x, y, collisionFilter, scale) {
    var verts = Matter.Svg.pathToVertices(document.getElementById(s.id), 10);
    verts = Matter.Vertices.scale(verts, scale, scale);
    var body = Matter.Bodies.fromVertices(x, y, verts, {
      collisionFilter: collisionFilter,
      density:     s.density     || 0.001,
      restitution: s.restitution || 0.10,
      friction:    s.friction    || 0.85,
      frictionAir: s.frictionAir || 0.020
    }, true);
    Matter.Body.setAngle(body, s.a);
    return body;
  }

  function init() {
    var stage = document.getElementById('shapes-stage');
    var W = stage.offsetWidth  || window.innerWidth;
    var H = stage.offsetHeight || window.innerHeight;
    var scale = (W / 1600) * 1.1;

    Matter.Common.setDecomp(window.decomp);
    engine = Matter.Engine.create();
    engine.world.gravity.y = 0.65;

    SHAPES.forEach(function (s) {
      var cf = s.id === 'sp0'
        ? { category: CAT_CHEVRON, mask: CAT_WALL | CAT_SHAPE | CAT_OVAL }
        : { category: CAT_SHAPE,   mask: CAT_WALL | CAT_SHAPE | CAT_CHEVRON };
      var body = makeBody(s, W * s.x, -s.y, cf, scale);
      bodies.push(body);
      Matter.World.add(engine.world, body);
    });

    var ovalBody = makeBody(OVAL, W * OVAL.x, -OVAL.y,
      { category: CAT_OVAL, mask: CAT_WALL | CAT_CHEVRON | CAT_SHAPE }, scale);
    bodies.push(ovalBody);
    Matter.World.add(engine.world, ovalBody);

    var wOpts = {
      isStatic: true,
      collisionFilter: { category: CAT_WALL, mask: CAT_SHAPE | CAT_CHEVRON | CAT_OVAL }
    };
    Matter.World.add(engine.world, [
      Matter.Bodies.rectangle(W / 2,  H + 55, W * 3, 110, wOpts),
      Matter.Bodies.rectangle(-55,    H / 2,  110, H * 3, wOpts),
      Matter.Bodies.rectangle(W + 55, H / 2,  110, H * 3, wOpts),
    ]);

    SHAPES.concat([OVAL]).forEach(function (s) {
      var w = s.vw * scale;
      var h = s.vh * scale;
      var el = document.createElement('div');
      el.className = s.id === 'sp5' ? 'shape shape--light' : 'shape';
      el.style.width  = w + 'px';
      el.style.height = h + 'px';
      el.innerHTML =
        '<svg viewBox="0 0 ' + s.vw + ' ' + s.vh + '" xmlns="http://www.w3.org/2000/svg">' +
        '<path fill="' + s.color + '" d="' + s.path + '"/></svg>';
      stage.appendChild(el);
      elements.push({ el: el, w: w, h: h });
    });

    runner = Matter.Runner.create();
    Matter.Runner.run(runner, engine);

    function tick() {
      rafId = requestAnimationFrame(tick);
      bodies.forEach(function (body, i) {
        var info = elements[i];
        info.el.style.left      = (body.position.x - info.w / 2) + 'px';
        info.el.style.top       = (body.position.y - info.h / 2) + 'px';
        info.el.style.transform = 'rotate(' + body.angle + 'rad)';
      });
    }
    tick();
  }

  function start() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    loadScript('https://cdn.jsdelivr.net/npm/pathseg@1.2.1/pathseg.js', function () {
      loadScript('https://cdn.jsdelivr.net/npm/poly-decomp@0.3.0/build/decomp.min.js', function () {
        loadScript('https://cdn.jsdelivr.net/npm/matter-js@0.19.0/build/matter.min.js', function () {
          setTimeout(init, 100);
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>
