---
const ar = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-kontakt">
      <a href="mailto:gard@gardlc.com" class="footer-lenke">gard@gardlc.com</a>
      <span class="footer-skillelinje" aria-hidden="true">·</span>
      <a href="https://gardlc.com" class="footer-lenke" target="_blank" rel="noopener noreferrer">gardlc.com</a>
    </div>
    <p class="footer-kopiert">© {ar}</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-mosegronn);
    border-top: 1px solid var(--color-border);
    padding-block: 2.5rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-navn {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-small);
  }

  .footer-kontakt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-lenke {
    font-family: var(--font-body);
    font-weight: var(--fw-book);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer-lenke:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer-skillelinje {
    color: var(--color-border);
    font-size: var(--fs-small);
  }

  .footer-kopiert {
    font-family: var(--font-body);
    font-weight: var(--fw-book);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
