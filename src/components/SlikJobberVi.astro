    max-width: var(--content-width);
  }

  .slik-tekst {
    max-width: var(--content-width);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .slik-tekst p {
    color: var(--color-text);
  }
</style>
