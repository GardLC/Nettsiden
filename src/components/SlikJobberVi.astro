<section class="slik-jobber-vi" aria-labelledby="slik-jobber-vi-overskrift">
  <div class="container">
    <h1 id="slik-jobber-vi-overskrift">Slik jobber jeg</h1>
    <div class="slik-tekst">
      <p class="body-large">
        Jeg starter alltid med innsikt, ikke løsninger. Og jeg jobber tett med de som kjenner organisasjonen best, for det er de som gjør at endringer faktisk holder.
      </p>
    </div>
    <a href="/slik-jobber-jeg" class="btn slik-les-mer">Les mer</a>
  </div>
</section>

<style>
  .slik-jobber-vi {
    padding-block: var(--section-spacing);
    background-color: var(--color-mosegronn);
  }

  .slik-jobber-vi h1 {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    max-width: var(--content-width);
    color: var(--color-text);
  }

  .slik-tekst {
    max-width: var(--content-width);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .slik-tekst p {
    color: var(--color-text);
  }

</style>
