<section class="innledning">
  <div class="content-grid">
    <div class="innledning-inner">
      <p class="innledning-bro">Norske arbeidsgivere bruker<br> store ressurser på&nbsp;å rekruttere <br>de rette menneskene</p>
      <p class="innledning-bro innledning-bro--siste">Innfasingen overlates<br> til tilfeldigheter</p>
    </div>
  </div>
</section>

<style>
  .innledning {
    padding-block: var(--section-spacing);
    background-color: var(--color-terrakotta);
    color: var(--color-text-light);
  }

  .innledning-bro {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h1);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: inherit;
    margin-block: 0;
  }

  .innledning-bro--siste {
    margin-top: 1em;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('.innledning');
  if (section) {
    const paragraphs = section.querySelectorAll<HTMLElement>('.innledning-bro');

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top 70%',
      },
    });

    tl.from(paragraphs[0], {
      opacity: 0,
      filter: 'blur(14px)',
      y: 10,
      duration: 1.1,
      ease: 'power2.out',
    }).from(paragraphs[1], {
      opacity: 0,
      filter: 'blur(14px)',
      y: 10,
      duration: 1.1,
      ease: 'power2.out',
    }, '+=0.2');
  }
</script>
