<section class="innledning">
  <div class="container">
    <div class="innledning-inner">
      <blockquote class="sitat">
        <p class="sitat-tekst body-large">«Vår innfasing er pinlig dårlig. Vi har snakket om det lenge.»</p>
        <footer class="sitat-kilde small">— Tech lead</footer>
      </blockquote>
      <blockquote class="sitat">
        <p class="sitat-tekst body-large">«Det er svært stressende. Jeg gjør jo ikke dette hver dag.»</p>
        <footer class="sitat-kilde small">— Avdelingsleder</footer>
      </blockquote>
      <blockquote class="sitat">
        <p class="sitat-tekst body-large">«Teknologistøtte? Jeg har en sjekkliste i et regneark.»</p>
        <footer class="sitat-kilde small">— CTO</footer>
      </blockquote>
    </div>
  </div>
</section>

<style>
  .innledning {
    padding-block: var(--section-spacing);
    background-color: var(--color-sand);
  }

  .innledning-inner {
    max-width: var(--content-width);
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .sitat {
    margin: 0;
  }

  .sitat-tekst {
    font-style: italic;
    line-height: var(--lh-body);
    margin-bottom: 0.35rem;
  }

  .sitat-kilde {
    color: var(--color-text-muted);
  }
</style>
