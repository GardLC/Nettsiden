---
const punkter = [
  {
    tittel: 'Ledere vet det ikke fungerer',
    detalj: '– men mangler tid, kompetanse og støtte',
  },
  {
    tittel: 'HR lager rutiner og prosesser isolert',
    detalj: '– uten å involvere brukerne, ledere og ansatte',
  },
  {
    tittel: 'Arbeidsgivere spør sjelden om opplevelsen',
    detalj: '– som gjør egen kvalitet til en blindsone',
  },
];
---

<section class="monster" aria-labelledby="monster-overskrift">
  <div class="container">
    <h1 id="monster-overskrift">Mønsteret er tydelig</h1>
    <ol class="monster-liste" role="list">
      {punkter.map((punkt, i) => (
        <li class="monster-punkt">
          <span class="monster-nummer" aria-hidden="true">{i + 1}</span>
          <div class="monster-tekst">
            <h2 class="monster-tittel">{punkt.tittel}</h2>
            <p class="monster-detalj body-large">{punkt.detalj}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="monster-stat">
      <p class="stat-ingress">De heldige som får en skikkelig god start er alt for få.</p>
      <span class="stat-tall" aria-label="12 prosent">12%</span>
      <div class="stat-kilde-blokk">
        <p class="stat-kilde">Kilde: GELx 2017 via HR Norge</p>
      </div>
    </div>
  </div>
</section>

<style>
  .monster {
    padding-block: var(--section-spacing);
    background-color: var(--color-off-white);
  }

  .monster h1 {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .monster-liste {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    max-width: 860px;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .monster-punkt {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .monster-nummer {
    font-family: var(--font-body);
    font-weight: var(--fw-book);
    font-size: var(--fs-small);
    line-height: var(--lh-heading);
    color: var(--color-text-muted);
    flex-shrink: 0;
    width: 1.25rem;
    padding-top: 0.2em;
  }

  .monster-tekst {
    flex: 1;
  }

  .monster-tittel {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h1);
    line-height: var(--lh-heading);
    margin-bottom: 0.25rem;
  }

  .monster-detalj {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .monster-stat {
    max-width: var(--content-width);
  }

  .stat-ingress {
    font-family: var(--font-body);
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    font-weight: var(--fw-regular);
    margin-bottom: 0.75rem;
  }

  .stat-tall {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    margin-bottom: 2.5rem;
  }

  .stat-kilde-blokk {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .stat-kilde {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: var(--fw-book);
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .monster-punkt {
      gap: 0.75rem;
    }
  }
</style>
