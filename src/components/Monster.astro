---
const punkter = [
  {
    tittel: 'Ledere vet det ikke fungerer',
    detalj: '– men mangler tid, kompetanse og støtte',
  },
  {
    tittel: 'HR lager rutiner og prosesser isolert',
    detalj: '– uten å involvere brukerne, ledere og ansatte',
  },
  {
    tittel: 'Arbeidsgivere spør sjelden om opplevelsen',
    detalj: '– som gjør egen kvalitet til en blindsone',
  },
];
---

<section class="monster" aria-labelledby="monster-overskrift">
  <div class="container">
    <h1 id="monster-overskrift">Mønsteret er tydelig</h1>
    <ol class="monster-liste" role="list">
      {punkter.map((punkt, i) => (
        <li class="monster-punkt">
          <span class="monster-nummer" aria-hidden="true">{i + 1}</span>
          <div class="monster-tekst">
            <h2 class="monster-tittel">{punkt.tittel}</h2>
            <p class="monster-detalj body-large">{punkt.detalj}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .monster {
    padding-block: var(--section-spacing);
    background-color: var(--color-off-white);
  }

  .monster h1 {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .monster-liste {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    max-width: 860px;
  }

  .monster-punkt {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .monster-nummer {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    color: var(--color-text-muted);
    flex-shrink: 0;
    width: 2.5rem;
  }

  .monster-tekst {
    flex: 1;
  }

  .monster-tittel {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    margin-bottom: 0.25rem;
  }

  .monster-detalj {
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 600px) {
    .monster-punkt {
      gap: 1rem;
    }
  }
</style>
