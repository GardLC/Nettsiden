---
const punkter = [
  {
    tittel: 'Ledere vet det ikke fungerer',
    detalj: '– men mangler tid, kompetanse og støtte',
  },
  {
    tittel: 'HR lager rutiner og prosesser isolert',
    detalj: '– uten å involvere brukerne, ledere og ansatte',
  },
  {
    tittel: 'Arbeidsgivere spør ikke om opplevelsen',
    detalj: '– som gjør egen kvalitet til en blindsone',
  },
];
---

<section class="monster" aria-labelledby="monster-overskrift">
  <div class="container">
    <h1 id="monster-overskrift">Mønsteret er tydelig</h1>
    <ol class="monster-liste" role="list">
      {punkter.map((punkt, i) => (
        <li class="monster-punkt">
          <div class="monster-tekst">
            <h2 class="monster-tittel">{punkt.tittel}</h2>
            <p class="monster-detalj">{punkt.detalj}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <footer class="kilde-blokk" aria-label="Kilder">
    <p>HR Norge 2021/23</p>
    <p>Egne intervjuer 2023</p>
  </footer>
</section>

<style>
  .monster {
    position: relative;
    background-color: var(--color-sand);
  }

  .monster h1 {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .stat-tekst {
    font-family: var(--font-body);
    font-size: var(--fs-body-large);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    color: var(--color-oliven-dyp);
    margin-bottom: 0.75rem;
  }

  .stat-kilde-blokk {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .stat-kilde {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: var(--fw-book);
    color: var(--color-text-muted);
  }

  .monster-liste {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    max-width: 860px;
  }

  .monster-punkt {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .monster-tekst {
    flex: 1;
  }

  .monster-tittel {
    font-family: var(--font-body);
    font-weight: var(--fw-book);
    font-size: 2.625rem;
    line-height: var(--lh-heading);
    margin-bottom: 0.25rem;
  }

  .monster-detalj {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 1.875rem;
    font-style: normal;
    color: var(--color-text);
  }

  @media (max-width: 600px) {
    .monster-punkt {
      gap: 0.75rem;
    }
  }
</style>