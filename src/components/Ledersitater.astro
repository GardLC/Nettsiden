---

<section class="ledersitater" aria-labelledby="ledersitater-overskrift">
  <div class="container">
    <h2 id="ledersitater-overskrift" class="ledersitater-tittel">
      Norske ledere om egen innfasing
    </h2>
    <ul class="sitatliste" role="list">
      <li class="sitat-blokk">
        <blockquote class="sitat">«Teknologistøtte? Jeg har en sjekkliste i et regneark.»</blockquote>
        <p class="sitat-kilde">CTO</p>
      </li>
      <li class="sitat-blokk">
        <blockquote class="sitat">«Det er svært stressende. Jeg gjør jo ikke dette hver dag.»</blockquote>
        <p class="sitat-kilde">Avdelingsleder</p>
      </li>
      <li class="sitat-blokk">
        <blockquote class="sitat">«Vår innfasing er pinlig dårlig. Vi har snakket om det lenge.»</blockquote>
        <p class="sitat-kilde">Tech lead</p>
      </li>
    </ul>
  </div>
  <footer class="kilde-blokk">
    <p class="kilde-tekst">Egne intervjuer 2023</p>
  </footer>
</section>

<style>
  .ledersitater {
    padding-block-start: calc(var(--headline-anchor) - 40px);
    position: relative;
  }

  .ledersitater-tittel {
    font-family: var(--font-body);
    font-size: 3.375rem; /* 54px */
font-weight: var(--fw-regular);
    line-height: var(--lh-heading);
    margin-bottom: 3rem;
  }

  .sitatliste {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 760px;
  }

  .ledersitater .sitat {
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    font-size: 2.5rem; /* 40px */
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .kilde-blokk {
    position: absolute;
    bottom: 2rem;
    right: var(--gutter);
  }

  .kilde-tekst {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 1.125rem;
    color: var(--color-text);
  }

  .sitat-kilde {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 1.125rem;
    color: var(--color-text);
  }
</style>
