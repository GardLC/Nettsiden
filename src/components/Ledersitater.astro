---
import fs from 'node:fs';
import path from 'node:path';

const lesSvg = (filnavn: string) =>
  fs.readFileSync(path.resolve(`./public/pictures/${filnavn}`), 'utf-8');

const bobler = [
  {
    svg: lesSvg('snakkeboble1g.svg'),
    label: 'Avdelingsleder: Det er svært stressende. Jeg gjør jo ikke dette hver dag.',
    side: 'venstre',
  },
  {
    svg: lesSvg('snakkeboble2g.svg'),
    label: 'Tech lead: Vår innfasing er pinlig dårlig. Vi har snakket om det lenge.',
    side: 'hoyre',
  },
  {
    svg: lesSvg('snakkeboble3g.svg'),
    label: 'CTO: Teknologistøtte? Jeg har en sjekkliste i et regneark.',
    side: 'venstre',
  },
];
---

<section class="ledersitater" aria-labelledby="ledersitater-overskrift">
  <div class="container">
    <h2 id="ledersitater-overskrift" class="ledersitater-tittel">
      Norske ledere om egen innfasing
    </h2>
    <ul class="boble-liste" role="list">
      {bobler.map((b) => (
        <li class={`boble-element boble-element--${b.side}`}>
          <figure class="boble" role="img" aria-label={b.label}>
            <Fragment set:html={b.svg} />
          </figure>
        </li>
      ))}
    </ul>
  </div>
  <footer class="kilde-blokk">
    <p class="kilde-tekst">Egne intervjuer 2023</p>
  </footer>
</section>

<style>
  .ledersitater {
    padding-block-start: var(--headline-anchor);
    padding-block-end: 6rem;
    padding-inline: clamp(1rem, 4vw, 3rem);
    position: relative;
  }

  .ledersitater-tittel {
    font-family: var(--font-body);
    font-size: var(--fs-h1);
    font-weight: var(--fw-regular);
    line-height: var(--lh-heading);
    margin: 0 0 3rem 0;
    white-space: nowrap;
  }

  .boble-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .boble-element {
    width: min(504px, 80%);
    position: relative;
  }

  .boble-element--venstre {
    align-self: flex-start;
  }

  .boble-element--hoyre {
    align-self: flex-end;
  }

  .boble-element:nth-child(1) {
    margin-inline-start: -2.5rem;
    transform: rotate(-1.6deg);
  }
  .boble-element:nth-child(2) {
    margin-inline-end: -3.5rem;
    transform: rotate(1.2deg);
  }
  .boble-element:nth-child(3) {
    margin-inline-start: 4rem;
    transform: rotate(-0.6deg);
  }

  .boble {
    margin: 0;
  }

  /* Sørg for at inlinede SVG-er skalerer responsivt */
  .boble :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Tving Alfabet og sort farge på attributionstekst i inlinede SVG-er */
  .boble :global(text),
  .boble :global(tspan) {
    font-family: alfabet, sans-serif !important;
    fill: #000 !important;
  }

  .kilde-blokk {
    position: absolute;
    bottom: 2rem;
    right: var(--gutter);
  }

  .kilde-tekst {
    margin: 0;
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: var(--fs-small);
    color: var(--color-text);
  }

  @media (max-width: 600px) {
    .ledersitater-tittel {
      font-size: 2.25rem;
      max-width: none;
      white-space: normal;
    }

    .boble-element:nth-child(1),
    .boble-element:nth-child(2),
    .boble-element:nth-child(3) {
      margin-inline: 0;
      transform: none;
    }
  }
</style>
