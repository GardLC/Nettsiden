---
const bobler = [
  {
    fil: 'snakkeboble1g.svg',
    alt: 'Avdelingsleder: Det er svært stressende. Jeg gjør jo ikke dette hver dag.',
    side: 'venstre',
  },
  {
    fil: 'snakkeboble2g.svg',
    alt: 'Tech lead: Vår innfasing er pinlig dårlig. Vi har snakket om det lenge.',
    side: 'hoyre',
  },
  {
    fil: 'snakkeboble3g.svg',
    alt: 'CTO: Teknologistøtte? Jeg har en sjekkliste i et regneark.',
    side: 'venstre',
  },
];
---

<section class="ledersitater" aria-labelledby="ledersitater-overskrift">
  <div class="container">
    <h2 id="ledersitater-overskrift" class="ledersitater-tittel">
      Norske ledere om egen innfasing
    </h2>
    <ul class="boble-liste" role="list">
      {bobler.map((b) => (
        <li class={`boble-element boble-element--${b.side}`}>
          <img
            src={`/pictures/${b.fil}`}
            alt={b.alt}
            class="boble-bilde"
            width="377"
            height="142"
          />
        </li>
      ))}
    </ul>
  </div>
  <footer class="kilde-blokk">
    <p class="kilde-tekst">Egne intervjuer 2023</p>
  </footer>
</section>

<style>
  .ledersitater {
    padding-block-start: var(--headline-anchor);
    padding-block-end: 6rem;
    padding-inline: clamp(1rem, 4vw, 3rem);
    position: relative;
  }

  .ledersitater-tittel {
    font-family: var(--font-body);
    font-size: 3.375rem;
    font-weight: var(--fw-regular);
    line-height: var(--lh-heading);
    margin: 0 0 3rem 0;
    white-space: nowrap;
  }

  .boble-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .boble-element {
    width: min(630px, 100%);
    position: relative;
  }

  .boble-element--venstre {
    align-self: flex-start;
  }

  .boble-element--hoyre {
    align-self: flex-end;
  }

  /* Bryt symmetri: ulike forskyvninger og lett rotasjon per boble */
  .boble-element:nth-child(1) {
    margin-inline-start: -2.5rem;
    transform: rotate(-1.6deg);
  }
  .boble-element:nth-child(2) {
    margin-inline-end: -3.5rem;
    transform: rotate(1.2deg);
  }
  .boble-element:nth-child(3) {
    margin-inline-start: 4rem;
    transform: rotate(-0.6deg);
  }

  .boble-bilde {
    display: block;
    width: 100%;
    height: auto;
  }

  .kilde-blokk {
    position: absolute;
    bottom: 2rem;
    right: var(--gutter);
  }

  .kilde-tekst {
    margin: 0;
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 1.125rem;
    color: var(--color-text);
  }

  @media (max-width: 600px) {
    .ledersitater-tittel {
      font-size: 2.25rem;
      max-width: none;
      white-space: normal;
    }

    .boble-element:nth-child(1),
    .boble-element:nth-child(2),
    .boble-element:nth-child(3) {
      margin-inline: 0;
      transform: none;
    }
  }
</style>
