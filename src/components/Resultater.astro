---
---

<section class="resultater" aria-labelledby="resultater-overskrift">
  <div class="container">
    <h2 id="resultater-overskrift" class="seksjon-overskrift">Når innfasingen er<br>strukturert for ansattes behov</h2>
    <div class="stat">
      <span class="stat-tall">50%</span>
      <ul class="stat-liste">
        <li>høyere produktivitet</li>
        <li>kortere innfasingstid</li>
      </ul>
      <p class="stat-notat">effekten kan måles flere år senere</p>
    </div>
    <footer class="kilde-blokk">
      <p class="kilde-tekst">Klein &amp; Heuser 2008<br>A. Hirsch 2017</p>
    </footer>
  </div>
</section>

<style>
  .resultater {
    padding-block: var(--headline-anchor) var(--section-spacing);
    background-color: #8c8d75;
  }

  .seksjon-overskrift {
    font-family: var(--font-body);
    font-size: var(--fs-h1);
    font-weight: var(--fw-regular); /* 400 */
    letter-spacing: -0.015em;
    line-height: var(--lh-heading);
    color: var(--color-text-light);
    max-width: var(--content-width);
    margin-top: 1rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .stat {
    display: grid;
    grid-template-columns: 40% 1fr;
    grid-template-rows: auto auto;
    column-gap: 2rem;
    row-gap: 1.5rem;
    max-width: var(--content-width);
  }

  .stat-tall {
    font-family: var(--font-body);
    font-size: 7rem;
    line-height: var(--lh-heading);
    font-weight: var(--fw-regular);
    color: var(--color-text-light);
    grid-row: 1 / 3;
    align-self: center;
  }

  .stat-liste {
    list-style: none;
    font-family: var(--font-body);
    font-size: var(--fs-h2);
    font-weight: var(--fw-book);   /* light, 300 */
    line-height: 1.25;
    color: var(--color-text-light);
  }

  .stat-liste li,
  .stat-notat {
    white-space: nowrap;
  }

  .stat-liste li::before {
    content: '-';
    margin-right: 0.4em;
  }

  .stat-notat {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 2.0064rem;
    color: var(--color-text-light);
  }

  .kilde-blokk {
    margin-top: clamp(2rem, 4vw, 3rem);
    text-align: right;
  }

  .kilde-tekst {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--color-text-light);
  }

  @media (max-width: 600px) {
    .stat {
      flex-direction: column;
      align-items: flex-start;
    }

    .stat-tall {
      flex: none;
      font-size: clamp(3rem, 18vw, var(--fs-h1));
    }

    .stat-liste {
      font-size: clamp(1.5rem, 6vw, var(--fs-h2));
    }

    .stat-liste li,
    .stat-notat {
      white-space: normal;
    }

    .stat-notat {
      font-size: clamp(1rem, 4vw, 2.0064rem);
    }

    .seksjon-overskrift {
      font-size: clamp(1.75rem, 7vw, var(--fs-h2));
    }
  }
</style>
