---
---

<section class="resultater" aria-labelledby="resultater-overskrift">
  <div class="container">
    <h2 id="resultater-overskrift" class="seksjon-overskrift">Når innfasingen er strukturert rundt ansattes behov</h2>
    <div class="stat">
      <span class="stat-tall">50%</span>
      <div class="stat-detaljer">
        <ul class="stat-liste">
          <li>høyere produktivitet</li>
          <li>kortere innfasingstid</li>
        </ul>
        <p class="stat-notat">effekten kan måles flere år senere</p>
      </div>
    </div>
  </div>
  <footer class="kilde-blokk">
    <p class="kilde-tekst">Klein &amp; Heuser 2008<br>A. Hirsch 2017</p>
  </footer>
</section>

<style>
  .resultater {
    padding-block: var(--headline-anchor) var(--section-spacing);
    background-color: var(--color-bg-box);
    min-height: calc(100vh - 3cm);
  }

  .seksjon-overskrift {
    font-family: var(--font-body);
    font-size: 3.375rem;            /* 54px */
    font-weight: var(--fw-regular); /* 400 */
    letter-spacing: -0.015em;
    line-height: var(--lh-heading);
    color: var(--color-accent);
    max-width: var(--content-width);
    margin-top: 1rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: var(--content-width);
  }

  .stat-tall {
    font-family: var(--font-body);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    flex: 0 0 40%;
  }

  .stat-detaljer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .stat-liste {
    list-style: none;
    font-family: var(--font-body);
    font-size: 2.8424rem;
    font-weight: var(--fw-book);   /* light, 300 */
    line-height: 1.25;
    color: var(--color-accent);
  }

  .stat-liste li,
  .stat-notat {
    white-space: nowrap;
  }

  .stat-liste li::before {
    content: '-';
    margin-right: 0.4em;
  }

  .stat-notat {
    font-family: var(--font-body);
    font-weight: var(--fw-regular); /* 400 */
    font-size: 2.0064rem;
    color: var(--color-text);       /* svart */
  }

  .kilde-blokk {
    margin-top: auto;               /* skyver til bunnen */
    padding-inline: var(--gutter);
    text-align: right;
  }

  .kilde-tekst {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--color-text);
  }
</style>
