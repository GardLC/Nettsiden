---
---

<section class="resultater" aria-labelledby="resultater-overskrift">
  <div class="container">
    <h2 id="resultater-overskrift" class="seksjon-overskrift">Når innfasingen er strukturert rundt nyansattes behov</h2>
    <div class="stat">
      <span class="stat-tall">50%</span>
      <ul class="stat-liste">
        <li>høyere produktivitet</li>
        <li>kortere innfasingstid</li>
      </ul>
    </div>
  </div>
  <footer class="kilde-blokk">
    <p class="kilde-tekst">Klein &amp; Heuser 2008<br>A. Hirsch 2017</p>
  </footer>
</section>

<style>
  .resultater {
    padding-block: var(--headline-anchor) var(--section-spacing);
    background-color: var(--color-bg-box);
    min-height: auto;
  }

  .seksjon-overskrift {
    font-family: var(--font-body);
    font-size: 3.375rem;
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    line-height: var(--lh-heading);
    max-width: var(--content-width);
    margin-top: 1rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: var(--content-width);
  }

  .stat-tall {
    font-family: var(--font-body);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    flex: 0 0 50%;
  }

  .stat-liste {
    list-style: none;
    font-family: var(--font-body);
    font-size: 1.875rem; /* fs-h2 + 8px */
    font-weight: var(--fw-regular);
    line-height: 2;
    text-align: center;
  }

  .stat-liste li::before {
    content: '–';
    margin-right: 0.4em;
  }

  .kilde-blokk {
    margin-top: 3rem;
    padding-inline: var(--gutter);
    text-align: right;
  }

  .kilde-tekst {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--color-text);
  }
</style>
