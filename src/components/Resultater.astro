---
---

<section class="resultater" aria-labelledby="resultater-overskrift">
  <div class="container">
    <h2 id="resultater-overskrift" class="seksjon-overskrift">Når innfasingen er designet for de nyansatte</h2>
    <div class="stat-grid">
      <div class="stat">
        <span class="stat-tall" aria-label="50 prosent">50%</span>
        <p class="stat-beskrivelse">høyere produktivitet</p>
        <p class="stat-kilde">Klein &amp; Heuser 2008</p>
      </div>
      <div class="stat">
        <span class="stat-tall" aria-label="50 prosent">50%</span>
        <p class="stat-beskrivelse">kortere tid til fullstendig innfasing</p>
        <p class="stat-kilde">A. Hirsch 2017</p>
      </div>
    </div>
  </div>
</section>

<style>
  .resultater {
    padding-block: var(--section-spacing);
    background-color: var(--color-salviegronn);
  }

  .seksjon-overskrift {
    font-family: var(--font-display);
    font-size: 3.75rem;
font-weight: var(--fw-regular);
    line-height: var(--lh-heading);
    max-width: var(--content-width);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    max-width: var(--content-width);
  }

  .stat-tall {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: var(--fw-medium);
    margin-bottom: 0.5rem;
  }

  .stat-beskrivelse {
    font-family: var(--font-body);
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    font-weight: var(--fw-regular);
    margin-bottom: 0.75rem;
  }

  .stat-kilde {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: var(--fw-book);
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .stat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
