---
const navLenker = [
  { tekst: 'Slik jobber jeg', href: '/slik-jobber-jeg' },
  { tekst: 'Om meg', href: '/om-meg' },
  { tekst: 'Artikler', href: '/artikler' },
  { tekst: 'Kontakt', href: '/#kontakt' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark" aria-label="Gard L. Christiansen – forsiden">
      <img src="/Gard_logo.webp" alt="Gard L. Christiansen" class="logo-bilde" />
    </a>

    <nav aria-label="Hovednavigasjon">
      <ul class="nav-liste" role="list">
        {navLenker.map(lenke => (
          <li>
            <a
              href={lenke.href}
              class="nav-lenke"
              aria-current={currentPath === lenke.href ? 'page' : undefined}
            >
              {lenke.tekst}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      class="hamburger"
      aria-expanded="false"
      aria-controls="mobil-meny"
      aria-label="Åpne meny"
    >
      <span class="hamburger-strek"></span>
      <span class="hamburger-strek"></span>
      <span class="hamburger-strek"></span>
    </button>
  </div>
</header>

<!-- Mobil-overlay -->
<div id="mobil-meny" class="mobil-overlay" aria-hidden="true" role="dialog" aria-label="Navigasjonsmeny">
  <button class="lukk-meny" aria-label="Lukk meny">✕</button>
  <nav aria-label="Mobilnavigasjon">
    <ul class="mobil-nav-liste" role="list">
      {navLenker.map(lenke => (
        <li>
          <a href={lenke.href} class="mobil-nav-lenke">{lenke.tekst}</a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: transparent;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .site-header.scrolled {
    background-color: transparent;
    border-bottom-color: transparent;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-bilde {
    height: 2.25rem;
    width: auto;
    display: block;
  }

  .nav-liste {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  .nav-lenke {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: var(--fs-small);
    text-decoration: none;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .nav-lenke:hover {
    color: var(--color-text-muted);
  }

  .nav-lenke[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger-strek {
    display: block;
    width: 24px;
    height: 1.5px;
    background-color: var(--color-text);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* Mobil-overlay */
  .mobil-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: var(--color-bg);
    z-index: 200;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .mobil-overlay.aktiv {
    display: flex;
  }

  .lukk-meny {
    position: absolute;
    top: 1.5rem;
    right: var(--gutter);
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--color-text);
    padding: 0.5rem;
  }

  .lukk-meny:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .mobil-nav-liste {
    list-style: none;
    text-align: center;
  }

  .mobil-nav-liste li + li {
    margin-top: 1.5rem;
  }

  .mobil-nav-lenke {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h1);
    text-decoration: none;
    color: var(--color-text);
  }

  .mobil-nav-lenke:hover {
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .site-header nav {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>

<script>
  const siteHeader = document.querySelector('.site-header') as HTMLElement | null;

  const oppdaterHeader = () => {
    siteHeader?.classList.toggle('scrolled', window.scrollY > 10);
  };
  window.addEventListener('scroll', oppdaterHeader, { passive: true });
  oppdaterHeader();

  const hamburger = document.querySelector('.hamburger') as HTMLButtonElement | null;
  const mobilMeny = document.getElementById('mobil-meny');
  const lukkKnapp = document.querySelector('.lukk-meny') as HTMLButtonElement | null;

  if (hamburger && mobilMeny && lukkKnapp) {
    const mobilLenker = document.querySelectorAll('.mobil-nav-lenke');

    const apneMeny = () => {
      mobilMeny.classList.add('aktiv');
      mobilMeny.setAttribute('aria-hidden', 'false');
      hamburger.setAttribute('aria-expanded', 'true');
      hamburger.setAttribute('aria-label', 'Lukk meny');
      lukkKnapp.focus();
      document.body.style.overflow = 'hidden';
    };

    const lukkMeny = () => {
      mobilMeny.classList.remove('aktiv');
      mobilMeny.setAttribute('aria-hidden', 'true');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.setAttribute('aria-label', 'Åpne meny');
      hamburger.focus();
      document.body.style.overflow = '';
    };

    hamburger.addEventListener('click', apneMeny);
    lukkKnapp.addEventListener('click', lukkMeny);
    mobilLenker.forEach(lenke => lenke.addEventListener('click', lukkMeny));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobilMeny.classList.contains('aktiv')) {
        lukkMeny();
      }
    });
  }
</script>
