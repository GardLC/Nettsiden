---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const artikler = await getCollection('artikler');
  return artikler.map(artikkel => ({
    params: { slug: artikkel.slug },
    props: { artikkel },
  }));
}

const { artikkel } = Astro.props;
const { Content } = await artikkel.render();

function formaterDato(dato: Date): string {
  return dato.toLocaleDateString('nb-NO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  tittel={artikkel.data.tittel}
  beskrivelse={artikkel.data.ingress}
>
  <Header />
  <main id="hovedinnhold">
    <article class="artikkel-side">
      <div class="content-container">
        <a href="/artikler" class="tilbake-lenke small">← Alle artikler</a>

        <header class="artikkel-header">
          <h1>{artikkel.data.tittel}</h1>
          <p class="body-large artikkel-ingress">{artikkel.data.ingress}</p>
          <div class="artikkel-meta">
            <time datetime={artikkel.data.publisert.toISOString()} class="small">
              {formaterDato(artikkel.data.publisert)}
            </time>
            {artikkel.data.oppdatert && (
              <span class="small">
                Oppdatert {formaterDato(artikkel.data.oppdatert)}
              </span>
            )}
            {artikkel.data.tema && artikkel.data.tema.length > 0 && (
              <ul class="tema-liste" role="list" aria-label="Tema">
                {artikkel.data.tema.map(t => (
                  <li class="tema-tag small">{t}</li>
                ))}
              </ul>
            )}
          </div>
        </header>

        <div class="prose">
          <Content />
        </div>

        <footer class="artikkel-footer">
          <a href="/artikler" class="btn">← Tilbake til artikler</a>
        </footer>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .artikkel-side {
    padding-block: var(--section-spacing);
  }

  .tilbake-lenke {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 2.5rem;
  }

  .tilbake-lenke:hover {
    color: var(--color-text);
  }

  .artikkel-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .artikkel-header h1 {
    margin-bottom: 1rem;
  }

  .artikkel-ingress {
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .artikkel-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--color-text-muted);
  }

  .tema-liste {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tema-tag {
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.125rem 0.5rem;
    color: var(--color-text-muted);
  }

  .artikkel-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
