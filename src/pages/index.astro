---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Innledning from '../components/Innledning.astro';
import Ledersitater from '../components/Ledersitater.astro';
import Nyansattsitater from '../components/Nyansattsitater.astro';
import Monster from '../components/Monster.astro';
import Resultater from '../components/Resultater.astro';
import Tilnaerming from '../components/Tilnaerming.astro';
import SlikJobberVi from '../components/SlikJobberVi.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout
  tittel="Gard L. Christiansen"
  beskrivelse="Designdrevet HR-utviklingsarbeid — bedre arbeidshverdager skapes sammen med de ansatte og deres ledere."
>
  <main id="hovedinnhold">
    <Hero />
    <Innledning />
    <Ledersitater />
<Nyansattsitater />
    <Monster />
    <Tilnaerming />
    <Resultater />
    <SlikJobberVi />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
