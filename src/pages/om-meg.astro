---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  tittel="Kort om meg"
  beskrivelse="Om Gard L. Christiansen — designdrevet HR-utviklingsarbeid i norske teknologiselskaper."
>
  <main id="hovedinnhold">
    <article class="om-side">
      <div class="container">
        <header class="om-header">
          <h1>Kort om meg</h1>
        </header>

        <!-- Meg på 2 minutter -->
        <section id="kort" class="om-del" aria-labelledby="kort-overskrift">
          <h2 id="kort-overskrift">Meg på 2 minutter</h2>
          <div class="om-del-innhold">
            <div class="om-foto-wrapper">
              <img src="/pictures/gardfoto.png" alt="Gard L. Christiansen" class="om-foto" />
            </div>
            <div class="om-bio">
              <p class="body-large">
                Jeg jobber med ledere og HR for å utvikle bedre opplevelser på arbeidsplassen.
              </p>
              <p>
                Bakgrunnen min er mange år som leder og rekrutteringsrådgiver for teknologiselskaper, kombinert med høyere utdannelse i tjenestedesign. Et fag som handler om å samarbeide for å lage helhetlige tjenester rundt behovene til menneskene som bruker dem. Moderne HR handler om det samme: å forme arbeidshverdagen rundt behovene til de unike menneskene som jobber i organisasjonen.
              </p>
              <p>
                I praksis gjør jeg det enklere for ledere, HR og ansatte å utforske hvor ting lugger, før vi finner løsninger som gjør hverdagen mer engasjerende og givende. Etter mange år som rådgiver er jeg vant til å samarbeide tett med ledere og team i ulike organisasjoner.
              </p>
              <p>
                <!-- PLASSHOLDER: avsnitt 4 — kontekst / privat -->
              </p>
            </div>
          </div>
        </section>

        <hr />
          >
            Se portefølje på gardlc.com
          </a>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .om-side {
    padding-block-start: calc(var(--section-spacing) + 4rem);
    padding-block-end: var(--section-spacing);
    background-color: var(--color-sand);
  }

  .om-header {
    margin-bottom: clamp(3rem, 6vw, 4rem);
  }

  .om-header h1 {
    margin-bottom: 1rem;
  }

  .anker-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .anker-nav span {
    color: var(--color-border);
  }

  .anker-lenke {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .anker-lenke:hover {
    color: var(--color-text);
  }

  .om-del {
    margin-bottom: clamp(3rem, 6vw, 5rem);
    max-width: 900px;
  }

  .om-del h2 {
    margin-bottom: 2rem;
  }

  .om-del-innhold {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: flex-start;
  }

  .om-foto {
    width: 220px;
    height: auto;
    border-radius: var(--radius);
    display: block;
    mix-blend-mode: multiply;
  }

  .om-bio {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .om-bio .body-large {
    color: var(--color-text-muted);
  }

  .om-lang-ingress {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .om-lang-innhold {
    margin-bottom: 2rem;
    color: var(--color-text-muted);
    min-height: 4rem;
  }

  @media (max-width: 700px) {
    .om-del-innhold {
      grid-template-columns: 1fr;
    }

    .foto-plassholder {
      width: 140px;
    }
  }
</style>
