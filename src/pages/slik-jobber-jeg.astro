---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Accordion from '../components/Accordion.astro';

const prinsipperItems = [
  {
    tittel: 'Helhetlig',
    forklaring: 'Tjenester må sees som en sammenhengende opplevelse, ikke som enkeltstående kontaktpunkter eller prosesser. Målet er å forstå hvordan mennesker, systemer, organisasjon og teknologi påvirker hverandre over tid.',
  },
  {
    tittel: 'Menneskeorientert',
    forklaring: 'Tjenestedesign tar utgangspunkt i behovene, erfaringene og situasjonene til menneskene tjenesten er til for. Innsikt fra brukere og ansatte brukes aktivt for å skape løsninger som oppleves relevante og nyttige.',
  },
  {
    tittel: 'Samskapende',
    forklaring: 'Når ansatte involveres i arbeidet blir løsningen mer treffsikre og endringsprosesser enklere. Vi fremmer kraften av tverrfaglig samarbeid, og involvering av relevante aktører gjennom hele prosessen.',
  },
  {
    tittel: 'Iterativt',
    forklaring: 'Tjenestedesign handler om å utforske, teste og forbedre løsninger steg for steg. Arbeidet skjer i flere runder hvor læring og tilbakemeldinger brukes til å justere retning underveis. Sånn de-risker vi større kostbare prosjekter',
  },
  {
    tittel: 'Gjennomførbart',
    forklaring: 'Løsninger må fungere i praksis og kunne leveres konsistent. Derfor balanseres brukerbehov med organisasjonens ressurser, mål og rammebetingelser.',
  },
  {
    tittel: 'Visuelt',
    forklaring: 'Visualisering brukes for å gjøre komplekse sammenhenger enklere å forstå og diskutere. Skisser, kart og prototyper gjør ideer mer konkrete og skaper et bedre grunnlag for samarbeid og beslutninger.',
  },
].map((p, i) => ({ ...p, etikett: String(i + 1).padStart(2, '0') }));

const metodesteg = [
  { navn: 'Forstå og ramme inn' },
  { navn: 'Utforske mulighetsrommet' },
  { navn: 'Teste' },
  { navn: 'Implementere' },
];
---

<BaseLayout
  tittel="Slik jobber jeg"
  beskrivelse="Prinsipper og metode for designdrevet HR-utviklingsarbeid."
>
  <main id="hovedinnhold">
    <article class="side-innhold">
      <div class="container">
        <header class="side-header">
          <h1>Slik jobber jeg</h1>
          <p class="body-large side-ingress">
            Som designer er det mange som tror jeg jobber med estetikk, men sannheten er det handler om hvordan ting fungerer. Jeg kaller meg derfor en kreativ problemløser som er utstyrt med metoder og verktøy som gjør det lettere å samarbeide for å utvikle hele arbeidsplassen.
          </p>
          <br>
          <p class="body-large side-ingress">
            Prinsippene skaper en felles retning og tydelige prioriteringer i utviklingsarbeidet. Det gjør det enklere å forstå behov, samarbeide på tvers og ta beslutninger som gir bedre løsninger til slutt.
          </p>
        </header>

        <!-- Prinsipper -->
        <section class="prinsipper-seksjon" aria-labelledby="prinsipper-overskrift">
          <h2 id="prinsipper-overskrift" class="seksjon-etikkett small">Prinsipper</h2>
          <Accordion items={prinsipperItems} />
        </section>

        <!-- Metode -->
        <section class="metode-seksjon" aria-labelledby="metode-overskrift">
          <h2 id="metode-overskrift" class="seksjon-etikkett small">Metode</h2>
          <ol class="metode-liste" role="list">
            {metodesteg.map((steg, i) => (
              <li class="metode-steg">
                <span class="steg-nummer" aria-hidden="true">{i + 1}</span>
                <div class="steg-tekst">
                  <h3 class="steg-navn">{steg.navn}</h3>
                  <p class="body-large steg-forklaring">
                    <!-- PLASSHOLDER: forklarende setning for {steg.navn} -->
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .side-innhold {
    padding-block: var(--section-spacing);
    background-color: var(--color-salviegronn);
  }

  .side-header {
    max-width: var(--content-width);
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .side-header h1 {
    margin-bottom: 1rem;
  }

  .side-ingress {
    color: var(--color-text-muted);
  }

  .seksjon-etikkett {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  /* Prinsipper */
  .prinsipper-seksjon {
    margin-bottom: clamp(3rem, 6vw, 5rem);
    max-width: var(--content-width);
  }

  /* Metode */
  .metode-seksjon {
    max-width: var(--content-width);
  }

  .metode-liste {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
  }

  .metode-steg {
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .steg-nummer {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .steg-navn {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    margin-bottom: 0.5rem;
  }

  .steg-forklaring {
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .metode-liste {
      grid-template-columns: 1fr;
    }
  }
</style>
