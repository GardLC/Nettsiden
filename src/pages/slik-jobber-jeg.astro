r---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Accordion from '../components/Accordion.astro';

const prinsipperItems = [
  {
    tittel: 'Helhetlig',
    forklaring: 'Rekruttering og innfasing oppleves av ansatte som en sammenhengende sosial prosess. Og det hjelper lite å løse et problem hvis vi skaper et nytt. Derfor må tiltak og handlinger ses i en sammenheng. Målet er å forstå hvordan mennesker, systemer, organisasjon og teknologi påvirker hverandre over tid.',
  },
  {
    tittel: 'Menneskeorientert',
    forklaring: 'Strategisk design tar utgangspunkt i behovene, erfaringene og situasjonene til menneskene tjenestene er til for. Innsikt fra ansatte og ledere brukes aktivt for å skape løsninger som svarer til deres behov.',
  },
  {
    tittel: 'Inkluderende',
    forklaring: 'Når ansatte involveres i både problemdefinering og nyskaping, bidrar de som eksperter på sine arbeidshverdager. Det gir bedre løsninger og endringsprosesser enklere. Vi fremmer kraften av tverrfaglig samarbeid, og involverer relevante aktører gjennom hele prosessen.',
  },
  {
    tittel: 'Iterativt',
    forklaring: 'Iterativt arbeid handler om å utforske, teste og forbedre løsninger steg for steg. Arbeidet skjer i flere runder hvor tilbakemeldingsløkker brukes til å justere retning underveis. Sånn de-risker vi større kostbare prosjekter og øker treffsikkerheten',
  },
  {
    tittel: 'Gjennomførbart',
    forklaring: 'Det hjelper lite med verdens beste intensjoner, løsninger må fungere i praksis og kunne leveres konsistent. Derfor balanseres ansatte og lederes behov med organisasjonens ressurser, mål og rammebetingelser.',
  },
  {
    tittel: 'Visuelt',
    forklaring: 'Vi jobber visuelt for å gjøre komplekse sammenhenger enklere å forstå og diskutere. Skisser, kart og prototyper gjør ideer mer konkrete og skaper et bedre grunnlag for inkluderende samarbeid og gode beslutninger.',
  },
].map((p, i) => ({ ...p, etikett: String(i + 1).padStart(2, '0') }));

const metodesteg = [
  {
    navn: 'Forstå og ramme inn',
    ikon: '/pictures/fase1.svg',
    forklaring: [
      'Vi går i dybden på menneskene og konteksten før vi definerer problemet, fordi en god løsning på feil problem gjør ingen forskjell.',
      'Innsikt fra observasjoner, samtaler og innhentet informasjon formes til en presis problemstilling, som vi justerer etter hvert som ny kunnskap kommer til.',
      'Den beste problemforståelsen kommer sjelden fra toppen, den finner vi hos de som lever med problemet til daglig.',
    ],
  },
  {
    navn: 'Ideskaping',
    ikon: '/pictures/fase2.svg',
    forklaring: [
      'Vi inkluderer ansatte og frigjør de kreative kreftene som bor i organisasjonen. Først veiledet idemyldring for å skape mange mulige løsninger.',
      'Før vi prioriterer ideene etter effekten de vil gi og innsatsen det krever.',
    ],
  },
  {
    navn: 'Teste og justere',
    ikon: '/pictures/fase3.svg',
    forklaring: [
      'Vi tar utvalgte ide/er og bygger raske og enkle prototyper som testes på ledere og ansatte.',
      'Prototyper kan være alt fra enkle tegninger til funksjonell teknologi.',
      'Tilbakemeldingene avdekker hva som fungerer og ikke, slik at vi kan justere før vi investerer tungt i én retning.',
    ],
  },
  {
    navn: 'Implementere, lede og engasjere',
    ikon: '/pictures/fase4.svg',
    forklaring: [
      'Her stopper gode løsninger ofte opp, fordi hverdagen er vanskeligere å endre enn å tegne.',
      'Når ledere og ansatte har vært med å forme løsningen, går de fra å være mål for endringen til å bli arkitekter bak den.',
      'Vi skaper varig endring, når ledere tar eierskap til prosessen og forsterker de nye arbeidsmåtene til de er blitt det normale.',
    ],
  },
];
---

<BaseLayout
  tittel="Slik jobber jeg"
  beskrivelse="Prinsipper og metode for designdrevet HR-utviklingsarbeid."
>
  <main id="hovedinnhold">
    <article class="side-innhold">
      <div class="content-grid">
        <header class="side-header">
          <h1>Slik jobber jeg</h1>
          <p class="body-large side-ingress">
            Jeg jobber fra en strategisk designers perspektiv.<br> Det betyr at jeg starter med menneskene det gjelder. <p>Gjennom det vi kaller taktisk empati lærer vi å forstå ansatte,<br> deres ledere og systemene rundt dem. </p><p>Vi identifiserer øyeblikkene som betyr noe, og hvor friksjon oppstår.<br> Bare da evner vi å identifisere og løse de viktigste problemene.<p> Deretter utforsker vi mulighetene sammen og tester dem før noe settes i drift. </p><p> Utfallet er bedre arbeidshverdager: mer engasjerte ansatte, og ledere som har overskudd når det gjelder som mest.
          </p>
          <p class="body-large side-ingress">
            Prinsippene skaper en felles retning og tydelige prioriteringer i utviklingsarbeidet. Det gjør det enklere å forstå behov, samarbeide på tvers og ta beslutninger som gir bedre løsninger til slutt.
          </p>
        </header>

        <!-- Prinsipper -->
        <section class="prinsipper-seksjon" aria-labelledby="prinsipper-overskrift">
          <h2 id="prinsipper-overskrift" class="seksjon-etikkett small">Prinsipper for utviklingsarbeid</h2>
          <Accordion items={prinsipperItems} />
        </section>

        <!-- Metode -->
        <section class="metode-seksjon" aria-labelledby="metode-overskrift">
          <h2 id="metode-overskrift" class="seksjon-etikkett small">Designfaser tilpasset HR</h2>
          <ol class="metode-liste" role="list">
            {metodesteg.map((steg, i) => (
              <li class="metode-steg">
                <div class="steg-ikon-wrapper">
                  <img class="steg-ikon" src={steg.ikon} alt="" aria-hidden="true" />
                </div>
                <div class="steg-header">
                  <span class="steg-nummer" aria-hidden="true">{i + 1}</span>
                  <p class="steg-navn">{steg.navn}</p>
                </div>
                <div class="steg-body">
                  {steg.forklaring.map(avsnitt => (
                    <p class="steg-forklaring">{avsnitt}</p>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .side-innhold {
    padding-block-start: calc(var(--section-spacing) + 4rem);
    padding-block-end: var(--section-spacing);
    background-color: var(--color-sand);
  }

  .prinsipper-seksjon,
  .metode-seksjon {
    background-color: transparent;
  }

  .side-header {
    max-width: var(--content-width);
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .side-header h1 {
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .side-ingress {
    color: var(--color-text);
    font-size: var(--fs-body);
  }

  .seksjon-etikkett {
    color: var(--color-text);
    margin-bottom: 2rem;
  }

  /* Prinsipper */
  .prinsipper-seksjon {
    margin-bottom: clamp(3rem, 6vw, 5rem);
    max-width: var(--content-width);
  }

  /* Metode */
  .metode-seksjon {
    grid-column: full;
    padding-inline: var(--gutter);
  }

  .metode-seksjon .seksjon-etikkett {
    margin-bottom: var(--space-2xl);
  }

  .metode-liste {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: var(--col-gap);
    row-gap: 0;
  }

  .metode-steg {
    grid-row: span 3;
    display: grid;
    grid-template-rows: subgrid;
  }

  .steg-header {
    position: relative;
    align-self: end;
  }

  .steg-nummer {
    position: absolute;
    right: calc(100% + var(--space-xs));
    top: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: 1.8125rem;
    line-height: var(--lh-heading);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .steg-ikon-wrapper {
    height: 10rem;
    display: flex;
    align-items: flex-end;
    margin-bottom: var(--space-m);
  }

  .steg-ikon {
    display: block;
    max-height: 100%;
    width: auto;
    max-width: 100%;
  }

  .steg-navn {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: 1.8125rem;
    line-height: var(--lh-heading);
  }

  .steg-body {
    margin-top: var(--space-s);
  }

  .steg-forklaring {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  @container layout (max-width: 48rem) {
    .metode-liste {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @container layout (max-width: 30rem) {
    .metode-liste {
      grid-template-columns: 1fr;
    }
  }
</style>
